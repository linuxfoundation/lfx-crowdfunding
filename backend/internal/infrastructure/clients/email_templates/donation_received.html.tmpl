{{- /* Legacy: admin-donation-notification-ledger */ -}}
{{template "header" .}}<h1 class="lfx-h1" style="font-size:28px;font-weight:700;color:#111827;margin:0 0 20px 0;line-height:1.25;font-family:Inter,Arial,'Helvetica Neue',Helvetica,sans-serif;">Hi {{.RecipientName}}!</h1>
<p style="font-size:16px;color:#374151;line-height:1.6;margin:0 0 16px 0;font-family:Inter,Arial,'Helvetica Neue',Helvetica,sans-serif;">Great news! Your initiative has just received a donation! Make sure you thank your donor and share the news about the donation with your community and on social media. Here are the donation details:</p>
<p style="font-size:15px;color:#374151;margin:0 0 24px 0;line-height:1.9;font-family:Inter,Arial,'Helvetica Neue',Helvetica,sans-serif;">
{{.DonationType}}: <strong style="color:#111827;">{{.InitiativeName}}</strong><br>
{{with .Category}}Category: {{.}}<br>{{end}}
Donor: {{.DonorName}} &lt;{{.DonorEmail}}&gt;<br>
{{with .OrgName}}Organization: {{.}}<br>{{end}}
Payment Type: {{.Payment}}<br>
Amount: <strong style="color:#111827;">{{.Amount}}</strong>
</p>
{{template "button" .InitiativeURL}}View donation{{template "button_end"}}{{template "signoff"}}{{template "footer" .}}
